# Use the latest stable version of Debian
FROM debian:stable-slim

# Create vscode user
RUN useradd -ms /bin/bash vscode

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    wget \
    ruby-full \
    zlib1g-dev \
    zsh \
    locales \
    locales-all \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configure locale
RUN update-locale

# Configure RubyGems for the vscode user
USER vscode

ENV GEM_HOME="/home/vscode/gems"
ENV PATH="/home/vscode/gems/bin:${PATH}"

# Install Bundler and Jekyll
RUN gem install bundler jekyll

# Install Oh My Zsh
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Configure Oh My Zsh
RUN sed -i 's/ZSH_THEME="robbyrussell"/ZSH_THEME="agnoster"/' /home/vscode/.zshrc \
    && sed -i 's/plugins=(git)/plugins=(git zsh-syntax-highlighting zsh-autosuggestions)/' /home/vscode/.zshrc \
    && git clone https://github.com/zsh-users/zsh-syntax-highlighting.git \
       /home/vscode/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting \
    && git clone https://github.com/zsh-users/zsh-autosuggestions.git \
       /home/vscode/.oh-my-zsh/custom/plugins/zsh-autosuggestions

# Verify installation
RUN ruby --version \
    && gem --version \
    && jekyll --version \
    && bundle --version

WORKDIR /workspace

SHELL ["/usr/bin/zsh", "-c"]

CMD ["zsh"]